# ----------------------------------------------------------------------------
# MODELO de variáveis de ambiente. COPIA este ficheiro para ".env" e preenche
# com os teus valores reais. O .env nunca vai para o git (está no .gitignore).
#
#   Windows PowerShell:  Copy-Item .env.example .env
#
# Em produção (Railway/Render) defines estas mesmas variáveis no painel deles,
# em vez de usares um ficheiro .env.
# ----------------------------------------------------------------------------

# Chave secreta do Django. Gera uma nova e única para o teu projeto. Podes gerar
# uma assim (depois de instalares as dependências):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=coloca-aqui-uma-chave-secreta-longa-e-aleatoria

# ⚠️ DEBUG expõe tracebacks e desliga as proteções de produção. Por defeito
# fica FALSE (seguro). Para desenvolvimento LOCAL, mete True no teu .env.
DEBUG=False

# Hosts autorizados a servir a app (separados por vírgula, sem espaços).
# Em produção acrescenta o domínio do Railway/Render.
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens do frontend autorizadas a chamar a API (CORS). Em dev é o Vite.
# Em produção acrescenta o domínio do site React.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Só em produção (DEBUG=False): domínios de confiança para CSRF (com https://).
# Ex.: https://o-teu-site.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Chave de cifragem dos campos sensíveis (fichas médicas, RGPD). OBRIGATÓRIA.
# Gera uma única com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=gera-uma-chave-fernet-e-cola-aqui

# --- Ligação ao PostgreSQL local ---
# Estes valores têm de bater certo com a tua instalação do Postgres.
POSTGRES_DB=gestao_recursos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=a-password-que-definiste-na-instalacao
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
