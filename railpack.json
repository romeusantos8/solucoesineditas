{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.13",
    "node": "22"
  },
  "steps": {
    "install": {
      "inputs": [
        "...",
        { "local": true, "include": ["frontend"] }
      ],
      "commands": [
        "...",
        "npm install --prefix frontend"
      ]
    },
    "build": {
      "commands": [
        "...",
        "npm run build --prefix frontend",
        "python manage.py collectstatic --no-input"
      ]
    }
  },
  "deploy": {
    "startCommand": "python manage.py migrate --no-input && gunicorn config.wsgi --bind 0.0.0.0:$PORT"
  }
}
